{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipe-venture-builder.local/runtime/schemas/Project.schema.json",
  "x-pipe-schema-version": "0.1.0",
  "title": "Project (Venture OS slice contract)",
  "type": "object",
  "required": ["id","name","slug","description","current_state","current_phase","status","state_version","next_action","blockers","artifact_refs","decision_refs","run_refs","created_at","updated_at"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "name": {"type":"string","minLength":1},
    "slug": {"type":"string","minLength":3},
    "description": {"type":"string"},
    "current_state": {"enum":["CREATED","INTAKE_IN_PROGRESS","INTAKE_REVIEW","INTAKE_APPROVED","PRODUCT_STRATEGY_READY","PRODUCT_STRATEGY_IN_PROGRESS","PRODUCT_STRATEGY_REVIEW","PRODUCT_STRATEGY_APPROVED","MVP_REFINEMENT_READY","PAUSED","BLOCKED","WAITING_HUMAN","FAILED","CANCELLED"]},
    "current_phase": {"type":"string"},
    "status": {"enum":["active","paused","waiting_human","blocked","failed","cancelled","ready_for_next_phase"]},
    "state_version": {"type":"integer"},
    "next_action": {"type":["object","null"]},
    "blockers": {"type":"array"},
    "artifact_refs": {"type":"array","items":{"type":"string"}},
    "decision_refs": {"type":"array","items":{"type":"string"}},
    "run_refs": {"type":"array","items":{"type":"string"}},
    "previous_state": {"type":["string","null"]},
    "created_at": {"type":"string"},
    "updated_at": {"type":"string"}
  }
}
